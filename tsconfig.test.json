{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "vitest/globals",
      "vitest",
      "@vitest/browser",
      "node",
      "cypress",
      "@testing-library/jest-dom",
      "@testing-library/cypress",
      "@playwright/test"
    ],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "allowJs": true
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.cy.ts",
    "src/**/*.cy.tsx",
    "src/**/__tests__/**/*",
    "tests/**/*"
  ],
  "exclude": ["node_modules"]
}

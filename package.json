{
  "name": "zaman",
  "version": "2.1.1",
  "description": "React component that helps you to makes simple Farsi/Jalali/Shamsi date picker. It also has range date picker you can select multiple days in multiple months.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./Calendar": {
      "types": "./dist/packages/Calendar/index.d.ts",
      "import": "./dist/packages/Calendar/index.js"
    },
    "./CalendarProvider": {
      "types": "./dist/packages/CalendarProvider/index.d.ts",
      "import": "./dist/packages/CalendarProvider/index.js"
    },
    "./DatePicker": {
      "types": "./dist/packages/DatePicker/index.d.ts",
      "import": "./dist/packages/DatePicker/index.js"
    },
    "./TimePicker": {
      "types": "./dist/packages/TimePicker/index.d.ts",
      "import": "./dist/packages/TimePicker/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && vite build --mode library",
    "build:clean": "rm -rf dist storybook-static coverage .nyc_output playwright-report test-results",
    "dev": "vite",
    "start": "storybook dev -p 6006",
    "watch": "vite build --mode library --watch",
    "lint": "ESLINT_USE_FLAT_CONFIG=true eslint src",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=true eslint --fix src",
    "format": "prettier src --write",
    "format:check": "prettier src --check",
    "prepare": "husky install",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "build-storybook": "storybook build",
    "type-check": "tsc --noEmit --project tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:coverage:report": "vitest run --coverage --reporter=json --reporter=html --reporter=text",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright test --reporter=html,json",
    "playwright:install": "playwright install --with-deps",
    "size": "du -sh dist && du -sb dist | awk '{print \"Size in bytes: \" $1}'",
    "size:limit": "bundlesize",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "changelog:first": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "version": "conventional-changelog -p angular -i CHANGELOG.md -s && git add CHANGELOG.md",
    "prerelease": "pnpm ci",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "prepublishOnly": "pnpm ci",
    "ci": "pnpm build:clean && pnpm type-check && pnpm lint && pnpm format:check && pnpm test:coverage && pnpm build && pnpm build-storybook",
    "ci:test": "pnpm type-check && pnpm lint && pnpm format:check && pnpm test:coverage",
    "ci:build": "pnpm build && pnpm build-storybook",
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:rzkhosroshahi/react-jalali-datepicker.git"
  },
  "keywords": [
    "datepicker",
    "farsi",
    "jalali",
    "shamsi"
  ],
  "author": "reza khosroshahi",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/rzkhosroshahi/react-jalali-datepicker/issues"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@chromatic-com/storybook": "^4.1.1",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@playwright/test": "^1.56.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.1",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^14.0.1",
    "@storybook/addon-a11y": "^9.1.10",
    "@storybook/addon-docs": "^9.1.10",
    "@storybook/addon-vitest": "^9.1.10",
    "@storybook/blocks": "9.0.0-alpha.17",
    "@storybook/react": "^9.1.10",
    "@storybook/react-vite": "^9.1.10",
    "@storybook/test": "^8.6.14",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/eslint": "^9.6.1",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^24.7.1",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.10",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "class-variance-authority": "^0.7.1",
    "conventional-changelog-cli": "^5.0.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "eslint-plugin-storybook": "^9.1.10",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.7",
    "jiti": "^2.4.2",
    "jsdom": "^27.0.0",
    "lint-staged": "^16.2.3",
    "playwright": "^1.56.0",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.1.0",
    "semantic-release": "^24.2.0",
    "storybook": "^9.1.10",
    "tailwindcss": "^4.1.14",
    "ts-node": "^10.9.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.18.1",
    "vite": "^7.1.9",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitepress": "2.0.0-alpha.12",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "dependencies": {
    "dayjs": "^1.11.18"
  },
  "packageManager": "pnpm@10.18.2+sha512.9fb969fa749b3ade6035e0f109f0b8a60b5d08a1a87fdf72e337da90dcc93336e2280ca4e44f2358a649b83c17959e9993e777c2080879f3801e6f0d999ad3dd"
}
